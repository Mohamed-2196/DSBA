# Copy to .env (never commit .env). docker compose reads it automatically.
# Local development uses the first block as it is. On a production server, keep only the second block and fill it in.

# ── Development (compose.yaml) ───────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=dsba
MINIO_ROOT_USER=dsba
MINIO_ROOT_PASSWORD=dsba-dev-secret
# Long random string in production: python -c "import secrets; print(secrets.token_urlsafe(48))"
DSBA_SECRET_KEY=dev-insecure-secret-change-me
# Email addresses that get Admin when they continue with Google while the hub has no admin (comma-separated)
DSBA_ADMIN_IDENTIFIERS=
# "Continue with Google": an OAuth client of your own (DEPLOYMENT.md, section 13). Off while either is empty.
# DSBA_GOOGLE_CLIENT_ID=
# DSBA_GOOGLE_CLIENT_SECRET=
# The Drive import (scripts/seed-real.sh): a Google API key restricted to the Drive API (DEPLOYMENT.md, section 10)
# DSBA_GOOGLE_API_KEY=
# Mini Noora's AI answers (switch noora.ai on in Access once it's set): a Claude API key from console.anthropic.com
# DSBA_ANTHROPIC_API_KEY=
# DSBA_NOORA_MODEL=claude-haiku-5-5
# Answers streaming at once, hub-wide. Also set a monthly spending limit on the Anthropic workspace as a backstop.
# DSBA_NOORA_ANSWERS_AT_ONCE=8

# ── Production (compose.prod.yaml; docs/backend/DEPLOYMENT.md) ───────────────────────────────
# Uncomment and fill in on the server. The API refuses to start while a setting is unsafe and names it.
# DSBA_DOMAIN=hub.example.com
# POSTGRES_PASSWORD=<long random string>
# DSBA_SECRET_KEY=<python -c "import secrets; print(secrets.token_urlsafe(48))">
# DSBA_ADMIN_IDENTIFIERS=you@example.com
# DSBA_GOOGLE_CLIENT_ID=<the OAuth client's id, ...apps.googleusercontent.com>
# DSBA_GOOGLE_CLIENT_SECRET=<its secret>
#
# Object storage (AWS S3, or MinIO behind HTTPS). Empty endpoint = AWS S3.
# DSBA_S3_ENDPOINT_URL=
# DSBA_S3_PUBLIC_ENDPOINT_URL=
# DSBA_S3_REGION=eu-central-1
# DSBA_S3_BUCKET=dsba-hub
# DSBA_S3_ACCESS_KEY_ID=
# DSBA_S3_SECRET_ACCESS_KEY=
# DSBA_S3_FORCE_PATH_STYLE=false
# The origin of the presigned URLs above, for the Content-Security-Policy:
# DSBA_BUCKET_ORIGIN=https://dsba-hub.s3.eu-central-1.amazonaws.com
#
# Backups: their own bucket and a key that can only write there (the API never holds it).
# DSBA_BACKUP_BUCKET=dsba-hub-backups
# DSBA_BACKUP_ACCESS_KEY_ID=
# DSBA_BACKUP_SECRET_ACCESS_KEY=
# DSBA_BACKUP_SSE=AES256
# DSBA_BACKUP_KEEP=14
#
# The text worker (search inside papers, covers) reads untrusted files, so it holds only its own database role and a
# key that can only read library/ and write covers/ (DEPLOYMENT.md, section 3). The password goes in a URL as it is:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# DSBA_TEXTS_DB_PASSWORD=
# DSBA_TEXTS_S3_ACCESS_KEY_ID=
# DSBA_TEXTS_S3_SECRET_ACCESS_KEY=
#
# Email (notifications and account notices)
# DSBA_EMAIL_FROM=DSBA Hub <no-reply@example.com>
# DSBA_SMTP_HOST=smtp.example.com
# DSBA_SMTP_PORT=587
# DSBA_SMTP_USERNAME=
# DSBA_SMTP_PASSWORD=
#
# The Drive import (scripts/seed-real.sh --prod; DEPLOYMENT.md, section 10): a Google API key restricted to the Drive
# API, and only for folders shared with chosen people, a service account's JSON key file (its path on the server).
# DSBA_GOOGLE_API_KEY=
# DSBA_GOOGLE_SERVICE_ACCOUNT_FILE=/etc/dsba/google-importer.json
#
# Docker network of compose.prod.yaml: change both if the subnet is taken on the server.
# DSBA_DOCKER_SUBNET=172.30.0.0/24
# DSBA_PROXY_IP=172.30.0.10
#
# Analytics (optional, off without a key; DEPLOYMENT.md section 9). Set at build time; the CSP then needs the host.
# VITE_POSTHOG_KEY=phc_...
# VITE_POSTHOG_HOST=https://eu.i.posthog.com
# DSBA_CSP_CONNECT_EXTRA=https://eu.i.posthog.com
