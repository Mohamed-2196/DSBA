# Copy to .env (never commit .env). docker compose reads it automatically.
# Local development uses the first block as it is. On a production server, keep only the second block and fill it in.

# ── Development (compose.yaml) ───────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=dsba
MINIO_ROOT_USER=dsba
MINIO_ROOT_PASSWORD=dsba-dev-secret
# Long random string in production: python -c "import secrets; print(secrets.token_urlsafe(48))"
DSBA_SECRET_KEY=dev-insecure-secret-change-me
# Emails / phone numbers that become admins when they first sign in (comma-separated)
DSBA_ADMIN_IDENTIFIERS=

# ── Production (compose.prod.yaml; docs/backend/DEPLOYMENT.md) ───────────────────────────────
# Uncomment and fill in on the server. The API refuses to start while a setting is unsafe and names it.
# DSBA_DOMAIN=hub.example.com
# POSTGRES_PASSWORD=<long random string>
# DSBA_SECRET_KEY=<python -c "import secrets; print(secrets.token_urlsafe(48))">
# DSBA_ADMIN_IDENTIFIERS=you@example.com
#
# Object storage (AWS S3, or MinIO behind HTTPS). Empty endpoint = AWS S3.
# DSBA_S3_ENDPOINT_URL=
# DSBA_S3_PUBLIC_ENDPOINT_URL=
# DSBA_S3_REGION=eu-central-1
# DSBA_S3_BUCKET=dsba-hub
# DSBA_S3_ACCESS_KEY_ID=
# DSBA_S3_SECRET_ACCESS_KEY=
# DSBA_S3_FORCE_PATH_STYLE=false
# The origin of the presigned URLs above, for the Content-Security-Policy:
# DSBA_BUCKET_ORIGIN=https://dsba-hub.s3.eu-central-1.amazonaws.com
#
# Backups: their own bucket and a key that can only write there (the API never holds it).
# DSBA_BACKUP_BUCKET=dsba-hub-backups
# DSBA_BACKUP_ACCESS_KEY_ID=
# DSBA_BACKUP_SECRET_ACCESS_KEY=
# DSBA_BACKUP_SSE=AES256
# DSBA_BACKUP_KEEP=14
#
# Email (sign-in codes)
# DSBA_EMAIL_FROM=DSBA Hub <no-reply@example.com>
# DSBA_SMTP_HOST=smtp.example.com
# DSBA_SMTP_PORT=587
# DSBA_SMTP_USERNAME=
# DSBA_SMTP_PASSWORD=
#
# Texts (sign-in codes by SMS). Leave DSBA_SMS_ALLOWED_REGIONS empty to turn them off.
# DSBA_SMS_ALLOWED_REGIONS=BH
# DSBA_TWILIO_ACCOUNT_SID=
# DSBA_TWILIO_AUTH_TOKEN=
# DSBA_TWILIO_FROM=
#
# Docker network of compose.prod.yaml: change both if the subnet is taken on the server.
# DSBA_DOCKER_SUBNET=172.30.0.0/24
# DSBA_PROXY_IP=172.30.0.10
