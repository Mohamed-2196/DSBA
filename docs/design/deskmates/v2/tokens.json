{
  "$name": "DSBA Hub · Deskmates v2",
  "brand": {
    "logo-blue": "#1F3A93",
    "lockup-light": "hub-lockup-horizontal.png",
    "lockup-dark": "hub-lockup-horizontal-white.png",
    "app-icon": "hub-icon.png",
    "rule": "Logo files are placed as they are: never redrawn, recoloured or outlined."
  },
  "color": {
    "light": {
      "canvas": "#F2F5FB", "surface": "#FFFFFF", "inset": "#ECF1F9", "raised": "#FFFFFF",
      "line": "#DCE4F1", "line-strong": "#C5D2E6",
      "ink": "#0A1F44", "ink-2": "#3E4E6E", "ink-3": "#5A6A8C",
      "accent": "#2445C2", "accent-edge": "#1F3A93", "accent-hover": "#1F3A93", "accent-soft": "#E3E9FF", "accent-text": "#1F3A93", "on-accent": "#FFFFFF",
      "focus": "#2445C2",
      "success": "#18794A", "warning": "#8F5A00", "warning-fill": "#FFC233", "error": "#C0262D", "exam": "#C21D5C", "on-exam": "#FFFFFF",
      "year": {
        "y1": { "fill": "#3BC9DB", "text": "#0A727C", "soft": "#D7F4F7" },
        "y2": { "fill": "#6FA2FF", "text": "#1A5FCC", "soft": "#DCE8FF" },
        "y3": { "fill": "#FFA94D", "text": "#9A5209", "soft": "#FFE8D1" }
      },
      "section": {
        "home":     { "mate": "Lumen",       "art": "#4C6EF5", "tint": "#C9D4FF", "pill": "#E3E9FF", "text": "#1F3A93" },
        "library":  { "mate": "Stacks",      "art": "#FFC233", "tint": "#FFE29A", "pill": "#FFF1C7", "text": "#865C00" },
        "modules":  { "mate": "Binder",      "art": "#2DB87D", "tint": "#B9EBD2", "pill": "#DDF5E9", "text": "#15744A" },
        "notebook": { "mate": "Jot",         "art": "#7B61FF", "tint": "#D9D0FF", "pill": "#ECE7FF", "text": "#5B3FD9" },
        "forum":    { "mate": "Pip and Pod", "art": "#F25CA2", "tint": "#FFC7E1", "pill": "#FFE3F0", "text": "#B0246B" },
        "calendar": { "mate": "Blink",       "art": "#F0524B", "tint": "#FFCBC6", "pill": "#FFE4E1", "text": "#C2332B" },
        "search":   { "mate": "Loupe",       "art": "#8E9BB8", "tint": "#D5DCEA", "pill": "#E6EBF4", "text": "#4A5878" },
        "tools":    { "note": "Boards, Grades, Career Navigator, Newsletter, Daily puzzles", "art": "#4C6EF5", "tint": "#C9D4FF", "pill": "#E3E9FF", "text": "#1F3A93" }
      },
      "icon": { "line": "#3E4E6E", "line-active": "#14234D", "paper": "#FFFFFF" },
      "noora": { "frame": "#E6E0FA", "ring": "#1F3A93", "online": "#18794A" }
    },
    "dark": {
      "canvas": "#0B1530", "surface": "#111E3E", "inset": "#1A2B54", "raised": "#16244A",
      "line": "#22355F", "line-strong": "#2F4677",
      "ink": "#EAF0FF", "ink-2": "#A9B8D9", "ink-3": "#8798BE",
      "accent": "#8DA6FF", "accent-edge": "#5F7BE0", "accent-hover": "#A9BCFF", "accent-soft": "#1E2C66", "accent-text": "#8DA6FF", "on-accent": "#0B1530",
      "focus": "#8DA6FF",
      "success": "#5BD49A", "warning": "#FFC233", "warning-fill": "#FFC233", "error": "#FF7A7A", "exam": "#FF7EB0", "on-exam": "#0B1530",
      "year": {
        "y1": { "fill": "#3BC9DB", "text": "#3BC9DB", "soft": "#123A45" },
        "y2": { "fill": "#6FA2FF", "text": "#6FA2FF", "soft": "#1B2D55" },
        "y3": { "fill": "#FFA94D", "text": "#FFA94D", "soft": "#3A2A1C" }
      },
      "section": {
        "home":     { "art": "#4C6EF5", "tint": "#33438F", "pill": "#1E2C66", "text": "#8DA6FF" },
        "library":  { "art": "#FFC233", "tint": "#6E5A22", "pill": "#3A3218", "text": "#FFC94D" },
        "modules":  { "art": "#2DB87D", "tint": "#1E5C45", "pill": "#15382C", "text": "#5BD49A" },
        "notebook": { "art": "#7B61FF", "tint": "#433889", "pill": "#2A2560", "text": "#AD9DFF" },
        "forum":    { "art": "#F25CA2", "tint": "#6E2D55", "pill": "#42213A", "text": "#FF8CC6" },
        "calendar": { "art": "#F0524B", "tint": "#6E3036", "pill": "#42222A", "text": "#FF8A80" },
        "search":   { "art": "#8E9BB8", "tint": "#3A4870", "pill": "#24304F", "text": "#AAB8D6" },
        "tools":    { "art": "#4C6EF5", "tint": "#33438F", "pill": "#1E2C66", "text": "#8DA6FF" }
      },
      "icon": { "line": "#A9B8D9", "line-active": "#EAF0FF", "paper": "#111E3E" },
      "art-halo": "#EAF0FF",
      "noora": { "frame": "#2A2F5E", "ring": "#8DA6FF", "online": "#5BD49A" }
    },
    "art": {
      "outline": "#14234D", "paper": "#FFFFFF", "paper-shade": "#DCE6F5", "paper-line": "#C9D5EA", "metal": "#9AA8C4", "metal-light": "#DCE3F0",
      "cheek": "#FF8FA3", "sparkle": "#FFC233", "zzz": "#5F6F92"
    }
  },
  "font": {
    "display": "'Bricolage Grotesque', 'IBM Plex Sans Arabic', system-ui, sans-serif",
    "ui": "'Figtree', 'IBM Plex Sans Arabic', system-ui, sans-serif",
    "mono": "'JetBrains Mono', ui-monospace, monospace",
    "arabic": "'IBM Plex Sans Arabic'",
    "google": "https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=Figtree:wght@400..800&family=JetBrains+Mono:wght@500;700&family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap"
  },
  "type": {
    "display-xl": { "size": 44, "line": 48, "weight": 750, "font": "display", "tracking": "-0.025em" },
    "display":    { "size": 34, "line": 40, "weight": 750, "font": "display", "tracking": "-0.025em" },
    "title":      { "size": 28, "line": 34, "weight": 750, "font": "display", "tracking": "-0.02em" },
    "heading":    { "size": 22, "line": 28, "weight": 750, "font": "display", "tracking": "-0.015em" },
    "subhead":    { "size": 17, "line": 24, "weight": 700, "font": "ui" },
    "body":       { "size": 16, "line": 25, "weight": 400, "font": "ui" },
    "body-sm":    { "size": 14, "line": 21, "weight": 400, "font": "ui" },
    "meta":       { "size": 13, "line": 18, "weight": 500, "font": "ui" },
    "overline":   { "size": 12, "line": 16, "weight": 800, "font": "ui", "tracking": "0.1em", "case": "upper" },
    "nav":        { "size": 15, "line": 20, "weight": 500, "weight-active": 700, "font": "ui" },
    "tab":        { "size": 12, "line": 16, "weight": 600, "weight-active": 800, "font": "ui" },
    "timer":      { "size": 40, "line": 44, "weight": 700, "font": "mono", "tracking": "-0.02em" },
    "code":       { "size": 13, "line": 18, "weight": 500, "font": "mono" },
    "arabic-body":{ "size": 16, "line": 28, "weight": 400, "font": "arabic" },
    "measure": "68ch"
  },
  "icon": { "grid": 24, "sizes": [24, 20], "stroke": 1.75, "stroke-active": 1.85, "search-handle": 2.75, "style": "duotone: line + section tint; active: navy line + full section colour on a pill" },
  "radius": { "chip": 999, "control": 14, "button": 13, "card": 18, "panel": 22, "sheet": 28, "nav-item": 14, "tab-pill": 17, "doc-thumb": 6 },
  "space": [2, 4, 8, 12, 16, 20, 24, 32, 40, 48, 64, 96],
  "border": { "hair": 1, "card": 1.5, "art": 5, "art-small": 2 },
  "shadow": {
    "light": { "card": "0 2px 6px rgba(10,31,68,0.07)", "press-edge": "inset 0 -3px 0 #1F3A93", "float": "0 8px 20px rgba(10,31,68,0.21)" },
    "dark":  { "card": "0 2px 6px rgba(0,0,0,0.35)", "press-edge": "inset 0 -3px 0 #5F7BE0", "float": "0 8px 24px rgba(0,0,0,0.6)" }
  },
  "size": { "touch-min": 44, "tabbar": 84, "sidebar": 248, "mate-header": 98, "mate-empty": 160, "mate-shelf": 56, "mate-toast": 40, "noora-launcher": 62 },
  "motion": {
    "ease": "cubic-bezier(0.2, 0.8, 0.2, 1)", "ease-bounce": "cubic-bezier(0.34, 1.56, 0.64, 1)",
    "fast": "140ms", "base": "200ms", "slow": "320ms",
    "blink-interval": "6s to 11s, random, one mate at a time, only while visible",
    "reduced": "no transforms or loops: states swap with a 120ms opacity fade"
  }
}
